@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="psc-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer"
                       AriaLabel="Toggle navigation" />
        <MudText Typo="Typo.h6" Class="ml-2">PSCenter</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2">PowerShell Administration Center</MudText>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Responsive"
               Elevation="1"
               Class="psc-drawer">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="psc-content">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#7c3aed",
            Secondary = "#22d3ee",
            Background = "#0f172a",
            Surface = "#111827",
            DrawerBackground = "#0b1220",
            AppbarBackground = "#111827",
            TextPrimary = "#f8fafc",
            TextSecondary = "#cbd5e1"
        }
    };

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}
